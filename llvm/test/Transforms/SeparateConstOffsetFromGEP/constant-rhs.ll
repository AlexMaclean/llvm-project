; LOWER-SAME: ptr [[BASE:%.*]], i8 [[X:%.*]]) {
; LOWER-NEXT:    [[BOUNDED:%.*]] = and i8 [[X]], 15
; LOWER-NEXT:    [[TMP1:%.*]] = zext i8 [[BOUNDED]] to i32
; LOWER-NEXT:    [[TMP2:%.*]] = zext i32 [[TMP1]] to i64
; LOWER-NEXT:    [[INNER1:%.*]] = xor i64 [[TMP2]], 1
; LOWER-NEXT:    [[OUTER2:%.*]] = add i64 [[INNER1]], 1024
; LOWER-NEXT:    [[UGLYGEP:%.*]] = getelementptr i8, ptr [[BASE]], i64 [[OUTER2]]
; LOWER-NEXT:    [[UGLYGEP4:%.*]] = getelementptr i8, ptr [[UGLYGEP]], i64 2064
; LOWER-NEXT:    ret ptr [[UGLYGEP4]]
;
  %bounded = and i8 %x, 15
  %inner = xor i8 %bounded, 17
  %ext = zext i8 %inner to i32
  %outer = add nuw i32 %ext, 1024
  %wide = zext i32 %outer to i64
  %index = add i64 %wide, 2048
  %gep = getelementptr i8, ptr %base, i64 %index
  ret ptr %gep
}
